      }&#10;        #manual-steps.show { display: block; }&#10;        .steps-title {&#10;            font-size: 0.78rem; font-weight: 700;&#10;            text-transform: uppercase; letter-spacing: 0.1em;&#10;            color: var(--muted); margin-bottom: 12px;&#10;        }&#10;        .step-item {&#10;            display: flex; gap: 12px; align-items: flex-start;&#10;            margin-bottom: 12px;&#10;        }&#10;        .step-num {&#10;            min-width: 24px; height: 24px;&#10;            background: rgba(99,102,241,0.2);&#10;            border-radius: 50%;&#10;            display: flex; align-items: center; justify-content: center;&#10;            font-size: 0.72rem; font-weight: 800; color: #a5b4fc;&#10;        }&#10;        .step-text {&#10;            font-size: 0.85rem; color: var(--muted); line-height: 1.5;&#10;            padding-top: 3px;&#10;        }&#10;        .step-text b { color: var(--text); }&#10;    &lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;&#10;&lt;!-- Animated Background --&gt;&#10;&lt;div class=&quot;bg-scene&quot;&gt;&#10;    &lt;div class=&quot;orb orb-1&quot;&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;orb orb-2&quot;&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;orb orb-3&quot;&gt;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&#10;&lt;div class=&quot;card&quot;&gt;&#10;    &lt;div class=&quot;app-icon&quot;&gt;&#10;        &lt;i class=&quot;fa-solid fa-indian-rupee-sign&quot;&gt;&lt;/i&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;app-name&quot;&gt;Denom's&lt;/div&gt;&#10;    &lt;div class=&quot;app-subtitle&quot;&gt;Denomination Manager · Cash Counter&lt;/div&gt;&#10;&#10;    &lt;div id=&quot;status-area&quot;&gt;&#10;        &lt;span id=&quot;status-badge&quot; class=&quot;status-badge ready&quot;&gt;&#10;            &lt;i class=&quot;fa-solid fa-circle-dot&quot;&gt;&lt;/i&gt;&#10;            &lt;span id=&quot;status-text&quot;&gt;Checking install status…&lt;/span&gt;&#10;        &lt;/span&gt;&#10;    &lt;/div&gt;&#10;&#10;    &lt;!-- Install Button (shown when installable) --&gt;&#10;    &lt;button id=&quot;btn-install&quot; class=&quot;btn-install&quot; onclick=&quot;doInstall()&quot; style=&quot;display:none&quot;&gt;&#10;        &lt;i class=&quot;fa-solid fa-download&quot;&gt;&lt;/i&gt; Install App&#10;    &lt;/button&gt;&#10;&#10;    &lt;!-- Open App (shown once installed) --&gt;&#10;    &lt;a id=&quot;btn-open&quot; href=&quot;./denominations.html&quot; class=&quot;btn-open&quot; style=&quot;display:none&quot;&gt;&#10;        &lt;i class=&quot;fa-solid fa-arrow-up-right-from-square&quot;&gt;&lt;/i&gt; Open App&#10;    &lt;/a&gt;&#10;&#10;    &lt;!-- Manual instructions toggle (shown when browser doesn't support prompt) --&gt;&#10;    &lt;button id=&quot;btn-manual&quot; class=&quot;btn-open&quot; onclick=&quot;toggleManual()&quot; style=&quot;display:none&quot;&gt;&#10;        &lt;i class=&quot;fa-solid fa-circle-info&quot;&gt;&lt;/i&gt; How to Install Manually&#10;    &lt;/button&gt;&#10;&#10;    &lt;a href=&quot;./denominations.html&quot; class=&quot;btn-back&quot;&gt;&#10;        &lt;i class=&quot;fa-solid fa-arrow-left&quot;&gt;&lt;/i&gt; Go to App&#10;    &lt;/a&gt;&#10;&#10;    &lt;!-- Manual Steps --&gt;&#10;    &lt;div id=&quot;manual-steps&quot;&gt;&#10;        &lt;!-- Filled by JS --&gt;&#10;    &lt;/div&gt;&#10;&lt;/div&gt;&#10;&#10;&lt;script&gt;&#10;    let deferredPrompt = null;&#10;    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);&#10;    const isAndroidChrome = /android/i.test(navigator.userAgent) &amp;&amp; /chrome/i.test(navigator.userAgent);&#10;    const isStandalone = () =&gt;&#10;        window.matchMedia('(display-mode: standalone)').matches ||&#10;        window.navigator.standalone === true;&#10;&#10;    function setStatus(text, type) {&#10;        const badge = document.getElementById('status-badge');&#10;        const label = document.getElementById('status-text');&#10;        label.textContent = text;&#10;        badge.className = 'status-badge ' + type;&#10;        if (type === 'ready')     badge.querySelector('i').className = 'fa-solid fa-circle-dot';&#10;        if (type === 'installed') badge.querySelector('i').className = 'fa-solid fa-circle-check';&#10;        if (type === 'manual')    badge.querySelector('i').className = 'fa-solid fa-circle-exclamation';&#10;    }&#10;&#10;    function show(id) { document.getElementById(id).style.display = 'flex'; }&#10;    function hide(id) { document.getElementById(id).style.display = 'none'; }&#10;&#10;    function showInstalledState() {&#10;        setStatus('App is already installed ✓', 'installed');&#10;        show('btn-open');&#10;        hide('btn-install');&#10;        hide('btn-manual');&#10;    }&#10;&#10;    function showInstallableState() {&#10;        setStatus('Ready to install', 'ready');&#10;        show('btn-install');&#10;        hide('btn-open');&#10;        hide('btn-manual');&#10;    }&#10;&#10;    function showManualState() {&#10;        setStatus('Manual install required', 'manual');&#10;        hide('btn-install');&#10;        hide('btn-open');&#10;        show('btn-manual');&#10;        buildManualSteps();&#10;    }&#10;&#10;    function buildManualSteps() {&#10;        const container = document.getElementById('manual-steps');&#10;        let steps = [];&#10;&#10;        if (isIOS) {&#10;            steps = [&#10;                { text: 'Open this page in &lt;b&gt;Safari&lt;/b&gt; browser (not Chrome/Firefox).' },&#10;                { text: 'Tap the &lt;b&gt;Share&lt;/b&gt; button &lt;i class=&quot;fa-solid fa-arrow-up-from-bracket&quot; style=&quot;color:#a5b4fc&quot;&gt;&lt;/i&gt; at the bottom of the screen.' },&#10;                { text: 'Scroll down and tap &lt;b&gt;&quot;Add to Home Screen&quot;&lt;/b&gt;.' },&#10;                { text: 'Tap &lt;b&gt;Add&lt;/b&gt; in the top-right corner.' },&#10;                { text: 'Done! Open &lt;b&gt;Denom\'s&lt;/b&gt; from your Home Screen.' }&#10;            ];&#10;        } else {&#10;            steps = [&#10;                { text: 'Open this page in &lt;b&gt;Chrome&lt;/b&gt; or &lt;b&gt;Edge&lt;/b&gt; browser.' },&#10;                { text: 'Tap the browser &lt;b&gt;menu (⋮ three dots)&lt;/b&gt; in the top-right corner.' },&#10;                { text: 'Tap &lt;b&gt;&quot;Install app&quot;&lt;/b&gt; or &lt;b&gt;&quot;Add to Home screen&quot;&lt;/b&gt;.' },&#10;                { text: 'Confirm by tapping &lt;b&gt;Install&lt;/b&gt; or &lt;b&gt;Add&lt;/b&gt;.' },&#10;                { text: 'Done! Open &lt;b&gt;Denom\'s&lt;/b&gt; from your Home Screen or App Drawer.' }&#10;            ];&#10;        }&#10;&#10;        container.innerHTML =&#10;            '&lt;div class=&quot;steps-title&quot;&gt;&lt;i class=&quot;fa-solid fa-list-ol mr-1&quot;&gt;&lt;/i&gt; Steps&lt;/div&gt;' +&#10;            steps.map(function(s, i) {&#10;                return '&lt;div class=&quot;step-item&quot;&gt;' +&#10;                    '&lt;div class=&quot;step-num&quot;&gt;' + (i + 1) + '&lt;/div&gt;' +&#10;                    '&lt;div class=&quot;step-text&quot;&gt;' + s.text + '&lt;/div&gt;' +&#10;                    '&lt;/div&gt;';&#10;            }).join('');&#10;    }&#10;&#10;    function toggleManual() {&#10;        const el = document.getElementById('manual-steps');&#10;        const isOpen = el.classList.toggle('show');&#10;        const btn = document.getElementById('btn-manual');&#10;        btn.innerHTML = isOpen&#10;            ? '&lt;i class=&quot;fa-solid fa-chevron-up&quot;&gt;&lt;/i&gt; Hide Steps'&#10;            : '&lt;i class=&quot;fa-solid fa-circle-info&quot;&gt;&lt;/i&gt; How to Install Manually';&#10;    }&#10;&#10;    function doInstall() {&#10;        if (!deferredPrompt) return;&#10;        deferredPrompt.prompt();&#10;        deferredPrompt.userChoice.then(function(choice) {&#10;            deferredPrompt = null;&#10;            if (choice.outcome === 'accepted') {&#10;                showInstalledState();&#10;            } else {&#10;                showManualState();&#10;            }&#10;        });&#10;    }&#10;&#10;    // ── Init ──&#10;    window.addEventListener('beforeinstallprompt', function(e) {&#10;        e.preventDefault();&#10;        deferredPrompt = e;&#10;        if (!isStandalone()) showInstallableState();&#10;    });&#10;&#10;    window.addEventListener('appinstalled', function() {&#10;        deferredPrompt = null;&#10;        showInstalledState();&#10;    });&#10;&#10;    // Check on load&#10;    window.addEventListener('load', function() {&#10;        if (isStandalone()) {&#10;            showInstalledState();&#10;        } else {&#10;            // Wait briefly for beforeinstallprompt, then fallback to manual&#10;            if (!deferredPrompt) {&#10;                setTimeout(function() {&#10;                    if (!deferredPrompt) {&#10;                        showManualState();&#10;                        buildManualSteps();&#10;                    }&#10;                }, 1500);&#10;            }&#10;        }&#10;    });&#10;&#10;    // Register service worker&#10;    if ('serviceWorker' in navigator) {&#10;        window.addEventListener('load', function() {&#10;            navigator.serviceWorker.register('./sw.js', { scope: './' })&#10;                .catch(function(e) { console.log('SW failed:', e); });&#10;        });&#10;    }&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;" />
